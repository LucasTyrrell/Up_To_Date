FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && \
    patchright install --with-deps chromium

COPY . .

# No fixed CMD: this image runs whichever job is scheduled, e.g.
#   docker-compose run worker python -m scraper.gradcracker_scraper
#   docker-compose run worker python -m agents.newsletter.graph
